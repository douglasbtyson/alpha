# Claude credentials (required unless TROONOOZ_DEMO=1). `ant auth login` profiles also work.
# ANTHROPIC_API_KEY=sk-ant-...

# Server
PORT=8787
# Use 0.0.0.0 to accept connections from other machines. Set TROONOOZ_API_TOKEN if you do.
HOST=127.0.0.1
# Require "Authorization: Bearer <token>" on /api requests (recommended for any non-local deployment).
TROONOOZ_API_TOKEN=

# Analysis
TROONOOZ_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
TROONOOZ_EFFORT=high
# Server-side refusal fallbacks (beta). Turn off if a proxy in front of the API rejects it.
TROONOOZ_FALLBACKS=on
TROONOOZ_WEB_SEARCH_MAX_USES=8
TROONOOZ_WEB_FETCH_MAX_USES=5
TROONOOZ_MAX_ZOOMS=6
# Look up domain registration age via rdap.org (sends the domain name to rdap.org).
TROONOOZ_RDAP=on

# Limits
TROONOOZ_MAX_FILES=20
TROONOOZ_MAX_FILE_MB=100
TROONOOZ_MAX_IMAGES=40
TROONOOZ_VIDEO_FRAMES=8
TROONOOZ_MAX_CONCURRENT=3

# Storage for finished reports
TROONOOZ_DATA_DIR=data

# Fixed sample reports, no API calls (for trying the UI)
TROONOOZ_DEMO=0
